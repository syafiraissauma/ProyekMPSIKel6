{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "includeFiles": "{config/**,includes/**,auth/**,items/**,transactions/**,categories/**,locations/**,history/**,reports/**,scan/**,settings/**,users/**,index.php,database.sql,setup_database.php}"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
